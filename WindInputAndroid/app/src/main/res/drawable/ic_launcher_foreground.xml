<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标前景层：白色 W + 橙色风点
     安全区：内容 bbox 对角约 617，位于中心 66dp 规范圆（1024 尺度半径 625.8）内 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- W 投影：暗蓝偏移副本，与主图标的浮起效果一致 -->
    <path
        android:pathData="M 318.5,386 L 399.5,686 L 491,453.5 L 582.5,686 L 663.5,386"
        android:strokeColor="#2E0B5BC9"
        android:strokeWidth="78"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- W 主体：WindInput 首字母，圆头圆角 -->
    <path
        android:pathData="M 318.5,375.5 L 399.5,675.5 L 491,443 L 582.5,675.5 L 663.5,375.5"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="78"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- 橙色圆点：径向渐变（VectorDrawable 的 strokeColor 不支持渐变，故用填充圆形） -->
    <path android:pathData="M 693.5,335 a 25.5,25.5 0 1,0 51,0 a 25.5,25.5 0 1,0 -51,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="711.35"
                android:centerY="324.8"
                android:gradientRadius="43.35">
                <item android:offset="0" android:color="#FFFFC46B" />
                <item android:offset="1" android:color="#FFFF7A29" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
