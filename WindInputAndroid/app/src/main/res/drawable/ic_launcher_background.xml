<?xml version="1.0" encoding="utf-8"?>
<!-- 自适应图标背景层：品牌蓝渐变 + 顶部高光 + 底部压暗，铺满 108dp 画布 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- 品牌蓝对角渐变：左上 #55BAFF → 品牌色 #2D92F0 → 右下 #1B7BE8 -->
    <path android:pathData="M0,0 L1024,0 L1024,1024 L0,1024 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="122.88"
                android:startY="0"
                android:endX="901.12"
                android:endY="1024">
                <item android:offset="0" android:color="#FF55BAFF" />
                <item android:offset="0.45" android:color="#FF2D92F0" />
                <item android:offset="1" android:color="#FF1B7BE8" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 顶部高光：白色 24% 渐隐，增加光面质感 -->
    <path android:pathData="M0,0 L1024,0 L1024,1024 L0,1024 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="512">
                <item android:offset="0" android:color="#3DFFFFFF" />
                <item android:offset="0.5" android:color="#00FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 底部压暗：深蓝 20% 渐显，增加重量感 -->
    <path android:pathData="M0,0 L1024,0 L1024,1024 L0,1024 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="665.6"
                android:endX="0"
                android:endY="1024">
                <item android:offset="0" android:color="#000B5BC9" />
                <item android:offset="1" android:color="#330B5BC9" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
